FROM python:3.12-slim-trixie
ARG REQUIREMENTS_FILE=requirements-api.txt
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY ${REQUIREMENTS_FILE} /opt/deploy/requirements.txt
RUN pip install --no-cache-dir -r /opt/deploy/requirements.txt
COPY start_service.py /opt/deploy/start_service.py
WORKDIR /project

